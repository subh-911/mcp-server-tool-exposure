# PostgreSQL MCP Server Configuration
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Connection pool settings
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server identification
SERVER_NAME=postgresql-mcp-server
SERVER_VERSION=1.0.0

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Maximum rows to return from a query
MAX_QUERY_ROWS=1000

# Query timeout in seconds
QUERY_TIMEOUT=30

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Allowed database schemas (JSON array)
# Only schemas in this list can be accessed
ALLOWED_SCHEMAS=["public"]

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable data export functionality
ENABLE_EXPORT=true

# Enable caching for schema information
ENABLE_CACHING=true
CACHE_TTL=300

# Maximum rows for export operations
MAX_EXPORT_ROWS=5000
